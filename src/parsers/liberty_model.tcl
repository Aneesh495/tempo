# Tempo Liberty (.lib) Semantic Library Model
# Extracts standard cells, pin attributes, timing arcs, and NLDM tables
# Namespace: ::tempo::liberty

namespace eval ::tempo::liberty {

    oo::class create Library {
        variable name
        variable time_unit
        variable cap_unit
        variable voltage_unit
        variable templates       ;# dict: template_name -> dict(var1, var2, index1, index2)
        variable cells           ;# dict: cell_name -> dict(...)

        constructor {} {
            my reset
        }

        method reset {} {
            set name ""
            set time_unit "1ns"
            set cap_unit "1pf"
            set voltage_unit "1V"
            set templates [dict create]
            set cells [dict create]
        }

        method get_name {} { return $name }
        method get_cells {} { return [dict keys $cells] }
        method has_cell {cname} { return [dict exists $cells $cname] }
        method get_cell {cname} {
            if {[dict exists $cells $cname]} {
                return [dict get $cells $cname]
            }
            return [dict create]
        }

        # Load library from AST generated by liberty_parser
        method load_ast {ast} {
            # Find the library group node
            set lib_group ""
            foreach g [dict get $ast _groups] {
                if {[dict get $g _name] eq "library"} {
                    set lib_group $g
                    break
                }
            }
            if {$lib_group eq ""} {
                return -code error "No 'library' group found in Liberty AST"
            }

            set name [lindex [dict get $lib_group _args] 0]
            set body [dict get $lib_group _body]
            set attrs [dict get $body _attrs]

            # Extract units if defined
            if {[dict exists $attrs "time_unit"]} {
                set time_unit [string trim [dict get $attrs "time_unit"] "\""]
            }
            if {[dict exists $attrs "voltage_unit"]} {
                set voltage_unit [string trim [dict get $attrs "voltage_unit"] "\""]
            }

            # Process group children (templates, cells)
            foreach g [dict get $body _groups] {
                set gname [dict get $g _name]
                switch -exact -- $gname {
                    "lu_table_template" {
                        my _parse_template $g
                    }
                    "cell" {
                        my _parse_cell $g
                    }
                }
            }
        }

        method _parse_template {grp} {
            set tname [lindex [dict get $grp _args] 0]
            set tbody [dict get $grp _body]
            set tattrs [dict get $tbody _attrs]

            set var1 ""
            set var2 ""
            set idx1 [list]
            set idx2 [list]

            if {[dict exists $tattrs "variable_1"]} { set var1 [dict get $tattrs "variable_1"] }
            if {[dict exists $tattrs "variable_2"]} { set var2 [dict get $tattrs "variable_2"] }

            if {[dict exists $tattrs "index_1"]} {
                set raw [dict get $tattrs "index_1"]
                set idx1 [my _clean_num_list $raw]
            }
            if {[dict exists $tattrs "index_2"]} {
                set raw [dict get $tattrs "index_2"]
                set idx2 [my _clean_num_list $raw]
            }

            dict set templates $tname [dict create \
                var1 $var1 \
                var2 $var2 \
                index1 $idx1 \
                index2 $idx2]
        }

        method _clean_num_list {raw} {
            set flat [join $raw " "]
            set clean [string map {"\"" "" "\{" "" "\}" "" "," " " "\\\n" " " "\\\r\n" " "} $flat]
            set res [list]
            foreach item $clean {
                set trimmed [string trim $item]
                if {$trimmed ne "" && [string is double -strict $trimmed]} {
                    lappend res [expr {$trimmed + 0.0}]
                }
            }
            return $res
        }

        method _parse_cell {grp} {
            set cname [lindex [dict get $grp _args] 0]
            set cbody [dict get $grp _body]
            set cattrs [dict get $cbody _attrs]

            set area 1.0
            if {[dict exists $cattrs "area"]} {
                set area [expr {[dict get $cattrs "area"] + 0.0}]
            }

            set is_sequential 0
            set ff_info [dict create]

            # Parse cell body
            set pins [dict create]
            foreach child [dict get $cbody _groups] {
                set ch_name [dict get $child _name]
                if {$ch_name eq "pin"} {
                    set pinfo [my _parse_pin $child]
                    set pname [dict get $pinfo name]
                    dict set pins $pname $pinfo
                } elseif {$ch_name eq "ff" || $ch_name eq "latch"} {
                    set is_sequential 1
                    set ff_body [dict get $child _body]
                    set ff_attrs [dict get $ff_body _attrs]
                    set ff_info [dict merge [dict create type $ch_name] $ff_attrs]
                }
            }

            dict set cells $cname [dict create \
                name $cname \
                area $area \
                is_sequential $is_sequential \
                ff_info $ff_info \
                pins $pins]
        }

        method _parse_pin {grp} {
            set pname [lindex [dict get $grp _args] 0]
            set pbody [dict get $grp _body]
            set pattrs [dict get $pbody _attrs]

            set dir "input"
            if {[dict exists $pattrs "direction"]} {
                set dir [string tolower [dict get $pattrs "direction"]]
            }

            set cap 0.0
            if {[dict exists $pattrs "capacitance"]} {
                set cap [expr {[dict get $pattrs "capacitance"] + 0.0}]
            }

            set max_cap 1.0e9
            if {[dict exists $pattrs "max_capacitance"]} {
                set max_cap [expr {[dict get $pattrs "max_capacitance"] + 0.0}]
            }

            set max_trans 1.0e9
            if {[dict exists $pattrs "max_transition"]} {
                set max_trans [expr {[dict get $pattrs "max_transition"] + 0.0}]
            }

            set is_clock 0
            if {[dict exists $pattrs "clock"]} {
                set cval [dict get $pattrs "clock"]
                if {$cval eq "true" || $cval == 1} { set is_clock 1 }
            }

            set func ""
            if {[dict exists $pattrs "function"]} {
                set func [string trim [dict get $pattrs "function"] "\""]
            }

            set timing_arcs [list]
            foreach child [dict get $pbody _groups] {
                if {[dict get $child _name] eq "timing"} {
                    lappend timing_arcs [my _parse_timing_arc $child]
                }
            }

            return [dict create \
                name $pname \
                direction $dir \
                capacitance $cap \
                max_capacitance $max_cap \
                max_transition $max_trans \
                is_clock $is_clock \
                function $func \
                timing_arcs $timing_arcs]
        }

        method _parse_timing_arc {grp} {
            set tbody [dict get $grp _body]
            set tattrs [dict get $tbody _attrs]

            set rel_pin ""
            if {[dict exists $tattrs "related_pin"]} {
                set rel_pin [string trim [dict get $tattrs "related_pin"] "\""]
            }

            set ttype "combinational"
            if {[dict exists $tattrs "timing_type"]} {
                set ttype [dict get $tattrs "timing_type"]
            }

            set tsense "non_unate"
            if {[dict exists $tattrs "timing_sense"]} {
                set tsense [dict get $tattrs "timing_sense"]
            }

            # Parse 2D tables: cell_rise, cell_fall, rise_transition, fall_transition,
            # rise_constraint, fall_constraint
            set tables [dict create]
            foreach tbl_grp [dict get $tbody _groups] {
                set tbl_type [dict get $tbl_grp _name]
                if {$tbl_type in {cell_rise cell_fall rise_transition fall_transition rise_constraint fall_constraint}} {
                    dict set tables $tbl_type [my _parse_lut $tbl_grp]
                }
            }

            return [dict create \
                related_pin $rel_pin \
                timing_type $ttype \
                timing_sense $tsense \
                tables $tables]
        }

        method _parse_lut {grp} {
            set tbl_tmpl [lindex [dict get $grp _args] 0]
            set tbody [dict get $grp _body]
            set tattrs [dict get $tbody _attrs]

            # Look up base template if specified
            set idx1 [list]
            set idx2 [list]
            if {$tbl_tmpl ne "" && [dict exists $templates $tbl_tmpl]} {
                set tinfo [dict get $templates $tbl_tmpl]
                set idx1 [dict get $tinfo index1]
                set idx2 [dict get $tinfo index2]
            }

            if {[dict exists $tattrs "index_1"]} {
                set idx1 [my _clean_num_list [dict get $tattrs "index_1"]]
            }
            if {[dict exists $tattrs "index_2"]} {
                set idx2 [my _clean_num_list [dict get $tattrs "index_2"]]
            }

            set val_matrix [list]
            if {[dict exists $tattrs "values"]} {
                set raw_vals [dict get $tattrs "values"]
                foreach r $raw_vals {
                    set nums [my _clean_num_list $r]
                    if {[llength $nums] > 0} {
                        lappend val_matrix $nums
                    }
                }
            }

            return [dict create \
                template $tbl_tmpl \
                index1 $idx1 \
                index2 $idx2 \
                matrix $val_matrix]
        }

        method _clean_string_rows {raw} {
            set rows [list]
            set parts [split $raw "\""]
            foreach p $parts {
                set trimmed [string trim $p]
                if {$trimmed ne "" && $trimmed ne "," && $trimmed ne "\\"} {
                    lappend rows $trimmed
                }
            }
            return $rows
        }

        # Bilinear lookup over NLDM table
        # x_val: input transition (slew)
        # y_val: output capacitance
        method evaluate_lut {lut x_val y_val} {
            set idx1 [dict get $lut index1]
            set idx2 [dict get $lut index2]
            set mat [dict get $lut matrix]

            set n1 [llength $idx1]
            set n2 [llength $idx2]

            if {$n1 == 0 || $n2 == 0 || [llength $mat] == 0} {
                return 0.0
            }

            # 1x1 table
            if {$n1 == 1 && $n2 == 1} {
                return [lindex [lindex $mat 0] 0]
            }

            # Clamp or find bounding interval in index_1 (x)
            set i0 0
            set i1 [expr {$n1 - 1}]
            for {set i 0} {$i < [expr {$n1 - 1}]} {incr i} {
                if {$x_val >= [lindex $idx1 $i] && $x_val <= [lindex $idx1 [expr {$i + 1}]]} {
                    set i0 $i
                    set i1 [expr {$i + 1}]
                    break
                }
            }
            if {$x_val < [lindex $idx1 0]} {
                set i0 0
                set i1 1
            } elseif {$x_val > [lindex $idx1 end]} {
                set i0 [expr {$n1 - 2}]
                set i1 [expr {$n1 - 1}]
            }

            # Clamp or find bounding interval in index_2 (y)
            set j0 0
            set j1 [expr {$n2 - 1}]
            for {set j 0} {$j < [expr {$n2 - 1}]} {incr j} {
                if {$y_val >= [lindex $idx2 $j] && $y_val <= [lindex $idx2 [expr {$j + 1}]]} {
                    set j0 $j
                    set j1 [expr {$j + 1}]
                    break
                }
            }
            if {$y_val < [lindex $idx2 0]} {
                set j0 0
                set j1 1
            } elseif {$y_val > [lindex $idx2 end]} {
                set j0 [expr {$n2 - 2}]
                set j1 [expr {$n2 - 1}]
            }

            set x0 [lindex $idx1 $i0]
            set x1 [lindex $idx1 $i1]
            set y0 [lindex $idx2 $j0]
            set y1 [lindex $idx2 $j1]

            set q00 [lindex [lindex $mat $i0] $j0]
            set q01 [lindex [lindex $mat $i0] $j1]
            set q10 [lindex [lindex $mat $i1] $j0]
            set q11 [lindex [lindex $mat $i1] $j1]

            return [::tempo::types::bilinear_interp $x_val $y_val $x0 $x1 $y0 $y1 $q00 $q01 $q10 $q11]
        }

        # Convenience method to evaluate cell propagation delay
        method lookup_delay {cell_name out_pin in_pin in_trans out_cap {trans_type "cell_rise"}} {
            if {![my has_cell $cell_name]} { return 0.0 }
            set cinfo [my get_cell $cell_name]
            set pins [dict get $cinfo pins]
            if {![dict exists $pins $out_pin]} { return 0.0 }
            set pinfo [dict get $pins $out_pin]

            foreach arc [dict get $pinfo timing_arcs] {
                if {[dict get $arc related_pin] eq $in_pin} {
                    set tbls [dict get $arc tables]
                    if {[dict exists $tbls $trans_type]} {
                        return [my evaluate_lut [dict get $tbls $trans_type] $in_trans $out_cap]
                    }
                }
            }
            return 0.0
        }

        # Convenience method to evaluate cell output transition (slew)
        method lookup_slew {cell_name out_pin in_pin in_trans out_cap {slew_type "rise_transition"}} {
            if {![my has_cell $cell_name]} { return 0.0 }
            set cinfo [my get_cell $cell_name]
            set pins [dict get $cinfo pins]
            if {![dict exists $pins $out_pin]} { return 0.0 }
            set pinfo [dict get $pins $out_pin]

            foreach arc [dict get $pinfo timing_arcs] {
                if {[dict get $arc related_pin] eq $in_pin} {
                    set tbls [dict get $arc tables]
                    if {[dict exists $tbls $slew_type]} {
                        return [my evaluate_lut [dict get $tbls $slew_type] $in_trans $out_cap]
                    }
                }
            }
            return 0.0
        }
    }

    # Reader helper proc
    proc read_liberty_file {filepath} {
        if {![file exists $filepath]} {
            return -code error "Liberty file does not exist: $filepath"
        }
        set fp [open $filepath r]
        set content [read $fp]
        close $fp

        set tokens [::tempo::liberty::lexer::tokenize $content]
        set ast [::tempo::liberty::parser::parse $tokens]

        set lib [::tempo::liberty::Library new]
        $lib load_ast $ast
        return $lib
    }
}
