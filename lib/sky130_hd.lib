/* ==============================================================================
 * SkyWater 130nm High-Density (sky130_fd_sc_hd) Standard Cell Library (Subset)
 * Operating Condition: TT (Typical-Typical, 1.8V, 25C)
 * ==============================================================================
 */

library (sky130_fd_sc_hd__tt_025C_1v80) {
    technology (cmos);
    delay_model : table_lookup;
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    pulling_resistance_unit : "1kohm";
    capacitive_load_unit (1, pf);

    nom_process : 1.0;
    nom_temperature : 25.0;
    nom_voltage : 1.80;

    lu_table_template (delay_template_3x3) {
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1 ("0.010, 0.050, 0.200");
        index_2 ("0.001, 0.010, 0.050");
    }

    lu_table_template (constraint_template_3x3) {
        variable_1 : constrained_pin_transition;
        variable_2 : related_pin_transition;
        index_1 ("0.010, 0.050, 0.200");
        index_2 ("0.010, 0.050, 0.200");
    }

    /* Inverter: sky130_fd_sc_hd__inv_1 */
    cell (sky130_fd_sc_hd__inv_1) {
        area : 1.0368;
        cell_leakage_power : 0.035;

        pin (A) {
            direction : input;
            capacitance : 0.0031;
            max_transition : 0.800;
        }

        pin (Y) {
            direction : output;
            capacitance : 0.0;
            max_capacitance : 0.120;
            function : "!A";

            timing () {
                related_pin : "A";
                timing_sense : negative_unate;
                timing_type : combinational;

                cell_rise (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.035, 0.078, 0.245", \
                            "0.055, 0.098, 0.265", \
                            "0.120, 0.165, 0.330");
                }

                cell_fall (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.030, 0.068, 0.210", \
                            "0.048, 0.086, 0.228", \
                            "0.105, 0.145, 0.290");
                }

                rise_transition (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.020, 0.065, 0.250", \
                            "0.030, 0.075, 0.260", \
                            "0.060, 0.105, 0.290");
                }

                fall_transition (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.018, 0.055, 0.210", \
                            "0.026, 0.063, 0.218", \
                            "0.052, 0.090, 0.245");
                }
            }
        }
    }

    /* 2-Input NAND: sky130_fd_sc_hd__nand2_1 */
    cell (sky130_fd_sc_hd__nand2_1) {
        area : 1.3824;
        cell_leakage_power : 0.048;

        pin (A) {
            direction : input;
            capacitance : 0.0035;
            max_transition : 0.800;
        }

        pin (B) {
            direction : input;
            capacitance : 0.0034;
            max_transition : 0.800;
        }

        pin (Y) {
            direction : output;
            capacitance : 0.0;
            max_capacitance : 0.115;
            function : "!(A & B)";

            timing () {
                related_pin : "A";
                timing_sense : negative_unate;
                timing_type : combinational;

                cell_rise (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.045, 0.095, 0.285", \
                            "0.068, 0.118, 0.308", \
                            "0.140, 0.190, 0.380");
                }

                cell_fall (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.040, 0.088, 0.260", \
                            "0.060, 0.108, 0.280", \
                            "0.125, 0.173, 0.345");
                }

                rise_transition (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.025, 0.075, 0.280", \
                            "0.035, 0.085, 0.290", \
                            "0.070, 0.120, 0.325");
                }

                fall_transition (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.022, 0.068, 0.245", \
                            "0.030, 0.076, 0.253", \
                            "0.062, 0.108, 0.285");
                }
            }

            timing () {
                related_pin : "B";
                timing_sense : negative_unate;
                timing_type : combinational;

                cell_rise (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.042, 0.092, 0.280", \
                            "0.065, 0.115, 0.303", \
                            "0.137, 0.187, 0.375");
                }

                cell_fall (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.038, 0.085, 0.255", \
                            "0.058, 0.105, 0.275", \
                            "0.122, 0.169, 0.340");
                }

                rise_transition (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.025, 0.075, 0.280", \
                            "0.035, 0.085, 0.290", \
                            "0.070, 0.120, 0.325");
                }

                fall_transition (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.022, 0.068, 0.245", \
                            "0.030, 0.076, 0.253", \
                            "0.062, 0.108, 0.285");
                }
            }
        }
    }

    /* 2-Input NOR: sky130_fd_sc_hd__nor2_1 */
    cell (sky130_fd_sc_hd__nor2_1) {
        area : 1.3824;
        cell_leakage_power : 0.046;

        pin (A) {
            direction : input;
            capacitance : 0.0036;
        }

        pin (B) {
            direction : input;
            capacitance : 0.0035;
        }

        pin (Y) {
            direction : output;
            function : "!(A | B)";

            timing () {
                related_pin : "A";
                timing_sense : negative_unate;
                timing_type : combinational;

                cell_rise (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.050, 0.110, 0.320", \
                            "0.075, 0.135, 0.345", \
                            "0.155, 0.215, 0.425");
                }

                cell_fall (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.035, 0.075, 0.225", \
                            "0.052, 0.092, 0.242", \
                            "0.110, 0.150, 0.300");
                }
            }
        }
    }

    /* 2-Input AND: sky130_fd_sc_hd__and2_1 */
    cell (sky130_fd_sc_hd__and2_1) {
        area : 1.7280;
        cell_leakage_power : 0.062;

        pin (A) {
            direction : input;
            capacitance : 0.0038;
        }

        pin (B) {
            direction : input;
            capacitance : 0.0037;
        }

        pin (Y) {
            direction : output;
            function : "A & B";

            timing () {
                related_pin : "A";
                timing_sense : positive_unate;
                timing_type : combinational;

                cell_rise (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.060, 0.120, 0.350", \
                            "0.085, 0.145, 0.375", \
                            "0.170, 0.230, 0.460");
                }

                cell_fall (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.055, 0.110, 0.330", \
                            "0.078, 0.133, 0.353", \
                            "0.155, 0.210, 0.430");
                }
            }
        }
    }

    /* D Flip-Flop: sky130_fd_sc_hd__dfxtp_1 */
    cell (sky130_fd_sc_hd__dfxtp_1) {
        area : 5.5296;
        cell_leakage_power : 0.185;

        ff ("IQ", "IQN") {
            next_state : "D";
            clocked_on : "CLK";
        }

        pin (CLK) {
            direction : input;
            capacitance : 0.0042;
            clock : true;
            min_pulse_width_high : 0.150;
            min_pulse_width_low : 0.150;
        }

        pin (D) {
            direction : input;
            capacitance : 0.0033;

            timing () {
                related_pin : "CLK";
                timing_type : setup_rising;

                rise_constraint (constraint_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.010, 0.050, 0.200");
                    values ("0.050, 0.052, 0.058", \
                            "0.055, 0.057, 0.063", \
                            "0.070, 0.072, 0.080");
                }

                fall_constraint (constraint_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.010, 0.050, 0.200");
                    values ("0.045, 0.047, 0.053", \
                            "0.050, 0.052, 0.058", \
                            "0.065, 0.067, 0.075");
                }
            }

            timing () {
                related_pin : "CLK";
                timing_type : hold_rising;

                rise_constraint (constraint_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.010, 0.050, 0.200");
                    values ("0.010, 0.010, 0.010", \
                            "0.010, 0.010, 0.010", \
                            "0.010, 0.010, 0.010");
                }

                fall_constraint (constraint_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.010, 0.050, 0.200");
                    values ("0.008, 0.008, 0.008", \
                            "0.008, 0.008, 0.008", \
                            "0.008, 0.008, 0.008");
                }
            }
        }

        pin (Q) {
            direction : output;
            capacitance : 0.0;
            max_capacitance : 0.090;
            function : "IQ";

            timing () {
                related_pin : "CLK";
                timing_sense : non_unate;
                timing_type : rising_edge;

                cell_rise (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.180, 0.235, 0.440", \
                            "0.205, 0.260, 0.465", \
                            "0.290, 0.345, 0.550");
                }

                cell_fall (delay_template_3x3) {
                    index_1 ("0.010, 0.050, 0.200");
                    index_2 ("0.001, 0.010, 0.050");
                    values ("0.165, 0.215, 0.410", \
                            "0.188, 0.238, 0.433", \
                            "0.265, 0.315, 0.510");
                }
            }
        }
    }
}
