# Tempo Structural Verilog Serializer
# Serializes ::tempo::netlist::Netlist objects into clean, compliant Verilog netlists
# Namespace: ::tempo::verilog::writer

namespace eval ::tempo::verilog::writer {

    # Serialize netlist to string or file
    proc serialize {netlist {filepath ""}} {
        set mod_name [$netlist get_name]
        set lines [list]

        lappend lines "// Generated by Tempo Electronic Design Automation Engine"
        lappend lines "// Module: $mod_name"
        lappend lines ""

        # Module header
        lappend lines "module $mod_name ("

        set port_lines [list]
        set in_ports [$netlist get_ports "INPUT"]
        set out_ports [$netlist get_ports "OUTPUT"]
        set inout_ports [$netlist get_ports "INOUT"]

        set all_ports [concat $in_ports $out_ports $inout_ports]
        set total_ports [llength $all_ports]

        for {set i 0} {$i < $total_ports} {incr i} {
            set p [lindex $all_ports $i]
            set comma [expr {$i < $total_ports - 1 ? "," : ""}]
            set pinfo [$netlist get_port_info $p]
            set dir [string tolower [dict get $pinfo dir]]
            set width [dict get $pinfo width]
            if {$width > 1} {
                set msb [dict get $pinfo msb]
                set lsb [dict get $pinfo lsb]
                lappend port_lines "    $dir \[$msb:$lsb\] $p$comma"
            } else {
                lappend port_lines "    $dir $p$comma"
            }
        }
        set lines [concat $lines $port_lines]
        lappend lines ");"
        lappend lines ""

        # Internal wires (exclude ports)
        set internal_wires [list]
        foreach n [$netlist get_nets] {
            if {![regexp {\[} $n] && ![$netlist has_port $n]} {
                lappend internal_wires $n
            }
        }
        if {[llength $internal_wires] > 0} {
            lappend lines "    // Internal nets"
            foreach w [lsort -dictionary $internal_wires] {
                lappend lines "    wire $w;"
            }
            lappend lines ""
        }

        # Instances
        lappend lines "    // Cell instances"
        foreach inst_name [lsort -dictionary [$netlist get_instances]] {
            set cell_type [$netlist get_instance_cell $inst_name]
            set pin_map [$netlist get_instance_pins $inst_name]

            set pin_conns [list]
            dict for {pin net} $pin_map {
                lappend pin_conns [format ".%s(%s)" $pin $net]
            }

            lappend lines "    $cell_type $inst_name ([join $pin_conns {, }]);"
        }

        lappend lines ""
        lappend lines "endmodule"
        lappend lines ""

        set out_text [join $lines "\n"]

        if {$filepath ne ""} {
            set fp [open $filepath w]
            puts -nonewline $fp $out_text
            close $fp
        }

        return $out_text
    }
}
